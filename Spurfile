_fail() {
  printf 'spur %s: %s\n' "$SPUR_TASK" "$2" >&2
  exit "$1"
}

_image_for() {
  case $1 in
    wasm* | native-clang* | schema-tool) echo wasm ;;
    windows* | schema-tool-windows) echo windows ;;
    *) echo dev ;;
  esac
}

_require_games_preset() {
  case $1 in
    wasm-games*) ;;
    *) _fail 64 "needs a wasm-games* preset (got: $1)" ;;
  esac
}

# _in IMAGE [--service SERVICE] [compose run options...] -- [task args...]
# Returns when this is the IMAGE toolchain; on the host, re-runs the task in
# the compose service. The compose options must end up before the service, and
# the task arguments after it, with no word splitting.
_in() {
  _image=$1
  _service=$1
  shift
  if [ "${1:-}" = --service ]; then
    _service=$2
    shift 2
  fi

  if [ "${OLY_TOOLCHAIN:-}" = "$_image" ]; then
    return 0
  fi

  if [ -n "${OLY_TOOLCHAIN:-}" ]; then
    _fail 64 "runs in the $_image image, this is the $OLY_TOOLCHAIN image"
  fi

  # 69 stays outside spur's own 64-68.
  if ! command -v docker > /dev/null 2>&1; then
    _fail 69 "this image predates OLY_TOOLCHAIN and has no docker: run './spur images' on the host"
  fi

  _options=0
  while [ "$1" != -- ]; do
    set -- "$@" "$1"
    shift
    _options=$((_options + 1))
  done
  shift

  set -- "$_service" ./spur "$SPUR_TASK" "$@"
  _rotate=$(($# - _options))
  while [ "$_rotate" -gt 0 ]; do
    set -- "$@" "$1"
    shift
    _rotate=$((_rotate - 1))
  done

  # Git Bash would rewrite arguments such as '^ecs\.' as Windows paths.
  export MSYS_NO_PATHCONV=1
  exec docker compose --env-file toolchain.env run --rm -e PRESET -e OLY_FUZZ_SEED -e OLY_FUZZ_OPS "$@"
}

# _serve <directory> <port>: serves a staged tree the way GitHub serves a release; stops when the task ends.
_serve() {
  mkdir -p build/staged
  python3 -m http.server "$2" --bind 127.0.0.1 --directory "$1" > "build/staged/server-$2.log" 2>&1 &
  _server=$!
  trap 'kill "$_server"' EXIT
  _attempts=0
  until python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:$2/')" 2> /dev/null; do
    _attempts=$((_attempts + 1))
    if [ "$_attempts" -ge 150 ]; then
      cat "build/staged/server-$2.log"
      _fail 1 "the release server did not answer on port $2"
    fi
    sleep 0.2
  done
}

# _staged_run <version> <web|native>: the staged consumer test over build/release/<version>, in build/staged/<environment>.
_staged_run() {
  [ -d "build/release/$1" ] || _fail 64 "run ./spur stage $1 first"
  rm -rf "build/staged/$2"

  _serve "build/release/$1" 8766
  OLY_RELEASE_URL=http://127.0.0.1:8766 OLY_ENGINE_SOURCE_DIR=$PWD sh tools/release/staged_consumer_test.sh "$1" "$2" "$PWD/build/staged/$2"
}

## Build the images with the toolchain versions of toolchain.env; the arguments go to docker compose build.
##
##   ./spur images wasm
images: ## build the images from toolchain.env (on the host)
  exec docker compose --env-file toolchain.env build "$@"

configure: ## cmake --preset $PRESET (default debug-asan)
  preset=${PRESET:-debug-asan}
  _in "$(_image_for "$preset")" -- "$@"

  cmake --preset "$preset"

build: ## configure and build $PRESET (default debug-asan)
  preset=${PRESET:-debug-asan}
  _in "$(_image_for "$preset")" -- "$@"

  PRESET=$preset spur configure
  cmake --build --preset "$preset" -j

## Run ctest on $PRESET after building it; the arguments go to ctest.
##
##   ./spur test -R '^ecs\.'
test: ## build and run the tests of $PRESET (default debug-asan)
  preset=${PRESET:-debug-asan}
  _in "$(_image_for "$preset")" -- "$@"

  PRESET=$preset spur build
  ctest --preset "$preset" --no-tests=error "$@"

## Run ctest on a native-games* preset (default native-games): the native host and the desktop games.
##
##   ./spur native-games-test -R '^native_host\.'
native-games-test: ## the tests of a native-games* preset
  preset=${PRESET:-native-games}
  case $preset in
    native-games*) ;;
    *) _fail 64 "needs a native-games* preset (got: $preset)" ;;
  esac

  PRESET=$preset spur test "$@"

## Cross-compile for Windows and run ctest on a windows* preset (default windows) under Wine.
##
##   ./spur windows-test -R '^native_host\.'
windows-test: ## the tests of a windows* preset, under Wine
  preset=${PRESET:-windows}
  case $preset in
    windows*) ;;
    *) _fail 64 "needs a windows* preset (got: $preset)" ;;
  esac

  PRESET=$preset spur test "$@"

## Run a command in the dev container, or a shell.
##
##   ./spur dev ./build/release/bench/ecs_bench_iterate
##   ./spur dev ./spur -x test   # trace a task
dev: ## command or shell in the dev container
  _in dev -- "$@"

  [ "$#" -gt 0 ] || set -- bash
  exec "$@"

## Run a command in the wasm container, or a shell.
##
##   ./spur wasm node --version
wasm: ## command or shell in the wasm container
  _in wasm -- "$@"

  [ "$#" -gt 0 ] || set -- bash
  exec "$@"

## Run a command in the windows container (MinGW and Wine), or a shell.
##
##   ./spur windows wine --version
windows: ## command or shell in the windows container
  _in windows -- "$@"

  [ "$#" -gt 0 ] || set -- bash
  exec "$@"

## Format with the dev image's clang-format, the one the CI checks against: the given files, or every tracked .cpp and
## .hpp file when there is none.
##
##   ./spur format engine/runtime/ecs/src/world.cpp
format: ## clang-format the given files, or every tracked .cpp/.hpp
  _in dev -- "$@"

  if [ "$#" -gt 0 ]; then
    exec clang-format -i "$@"
  fi

  # The mounted checkout belongs to another user than the container's, and git refuses to read it without this.
  git -c safe.directory='*' ls-files -z '*.cpp' '*.hpp' | xargs -0 clang-format -i

format-check: ## fail when a tracked .cpp/.hpp is not clang-formatted
  _in dev -- "$@"

  git -c safe.directory='*' ls-files -z '*.cpp' '*.hpp' | xargs -0 clang-format --dry-run --Werror

schema-tool: ## build oly-schema for the machine
  _in wasm -- "$@"

  # Built for the machine: a WASM build cannot run the oly-schema it compiles. Only in the wasm image; native presets
  # build oly-schema with the tree.
  cmake --preset schema-tool
  cmake --build --preset schema-tool -j

## Build cmake/tests/consumer, a project outside this tree that fetches the engine with FetchContent (here: this
## checkout), and run it. No argument: native, then web.
##
##   ./spur subproject-test web
subproject-test: ## build the FetchContent consumer fixture, native and web
  case ${1:-} in
    native) spur subproject-native ;;
    web) spur subproject-web ;;
    "")
      spur subproject-native
      spur subproject-web
      ;;
    *) _fail 64 "usage: ./spur subproject-test [native|web]" ;;
  esac

subproject-native: ## the native half of subproject-test
  _in dev -- "$@"

  directory=build/subproject-native
  # An incremental build skips the compile that prints the warning the check below looks for.
  rm -rf "$directory"
  cmake -S cmake/tests/consumer -B "$directory" -DFETCHCONTENT_SOURCE_DIR_OLY="$PWD"
  cmake --build "$directory" -j > "$directory/build.log" 2>&1 || { cat "$directory/build.log"; _fail 1 "the native consumer did not build"; }
  cat "$directory/build.log"
  grep -q 'warning: unused variable' "$directory/build.log" || _fail 1 "the consumer's own warning is gone: a subproject must not add -Werror to a game"

  "$directory/games/consumer" | grep -q '^consumer ok$' || _fail 1 "the native consumer did not print 'consumer ok'"
  [ ! -e "$directory/_deps/doctest-src" ] || _fail 1 "a subproject configure fetched doctest"
  if ctest --test-dir "$directory" -N | grep -q 'Test *#'; then
    _fail 1 "a subproject configure registered engine tests"
  fi

subproject-web: ## the web half of subproject-test
  _in wasm -- "$@"

  spur schema-tool

  directory=build/subproject-web
  # An incremental build does not relink, so the link line the check below looks for would be missing.
  rm -rf "$directory"
  cmake -S cmake/tests/consumer -B "$directory" \
    -DCMAKE_TOOLCHAIN_FILE=/emsdk/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake \
    -DFETCHCONTENT_SOURCE_DIR_OLY="$PWD" -DOLY_SCHEMA_TOOL="$PWD/build/schema-tool/bin/oly-schema"
  cmake --build "$directory" -j --verbose > "$directory/build.log" 2>&1 || { cat "$directory/build.log"; _fail 1 "the web consumer did not build"; }
  cat "$directory/build.log"
  grep -q -- '-sALLOW_MEMORY_GROWTH=1' "$directory/build.log" || _fail 1 "the web consumer links without -sALLOW_MEMORY_GROWTH=1"

  node --input-type=module -e 'const m = await import(process.argv[1]); await m.default(); console.log("consumer ok")' "file://$PWD/$directory/games/consumer.mjs"

ts: ## generate the schemas from a wasm-games* preset (default wasm-games) and build the TypeScript
  preset=${PRESET:-wasm-games}
  _require_games_preset "$preset"
  _in wasm -- "$@"

  spur schema-tool

  # The TS code imports the generated schemas, so they exist before tsc. A game's comes from its CMake target, the only
  # place that knows its plugins; a test-only schema is generated next to its .oly.
  PRESET=$preset spur configure
  cmake --build --preset "$preset" --target oly_typescript_schemas
  for schema in engine/testing/fixture/schemas/*.oly; do
    build/schema-tool/bin/oly-schema "$schema" --emit "ts=${schema%.oly}.generated.ts"
  done

  # npm is the one next to node: in the emsdk image it is not on the PATH.
  npm="$(dirname "$(command -v node)")/npm"
  [ -d node_modules ] || "$npm" ci --no-audit --no-fund
  "$npm" run build

## Build the TypeScript and run ctest on a wasm-games* preset (default wasm-games).
##
##   PRESET=wasm-games-release ./spur games-test -R '^ts\.'
games-test: ## ts, then the tests of a wasm-games* preset
  preset=${PRESET:-wasm-games}
  _require_games_preset "$preset"
  _in wasm -- "$@"

  PRESET=$preset spur ts
  PRESET=$preset spur test "$@"

## Run the tests of the game tasks (tools/oly/), which need no engine build.
##
##   ./spur oly-tools-test
oly-tools-test: ## the tests of tools/oly
  _in wasm -- "$@"

  sh tools/oly/tests/run.sh

## Create a game with the game tasks of this checkout (local mode) in build/consumer/, then build and test it, as a user
## of oly would. No argument: every environment.
##
##   ./spur consumer-test native
consumer-test: ## create, build and test a game from the template, in local mode
  case ${1:-} in
    native) spur consumer-native ;;
    web) spur consumer-web ;;
    docker) spur consumer-docker ;;
    "")
      spur consumer-native
      spur consumer-web
      spur consumer-docker
      ;;
    *) _fail 64 "usage: ./spur consumer-test [native|web|docker]" ;;
  esac

consumer-native: ## the native half of consumer-test
  _in dev -- "$@"

  version=$(sed -n 's/^project(Oly VERSION \([0-9.]*\).*/\1/p' CMakeLists.txt)
  directory=build/consumer/native
  rm -rf "$directory"
  mkdir -p "$directory"

  export OLY_ENGINE_DIR=$PWD
  launcher=$PWD/tools/oly/oly
  (cd "$directory" && sh "$launcher" new consumer-game --environment native --version "$version")
  (cd "$directory/consumer-game" && sh "$launcher" test)

consumer-web: ## the web half of consumer-test
  _in wasm -- "$@"

  version=$(sed -n 's/^project(Oly VERSION \([0-9.]*\).*/\1/p' CMakeLists.txt)
  npm="$(dirname "$(command -v node)")/npm"
  directory=build/consumer/web
  release=build/consumer/release
  releaseDirectory=$release/download/v$version

  # Only the two packages: the games' own TypeScript needs generated schemas this task does not make.
  [ -d node_modules ] || "$npm" ci --no-audit --no-fund
  node_modules/.bin/tsc -b engine/environments/web/clients/typescript/core engine/environments/web/host/js

  rm -rf "$directory" "$release"
  mkdir -p "$directory" "$releaseDirectory"
  "$npm" pack -w @oly/core -w @oly/web-host --pack-destination "$releaseDirectory"

  # What GitHub serves in a real release: the game installs the packages by URL.
  python3 -m http.server 8765 --bind 127.0.0.1 --directory "$release" > "$release/server.log" 2>&1 &
  server=$!
  trap 'kill "$server"' EXIT
  until python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8765/')" 2> /dev/null; do
    sleep 0.2
  done

  export OLY_ENGINE_DIR=$PWD OLY_TOOLS_DIR=$PWD/tools/oly OLY_RELEASE_URL=http://127.0.0.1:8765
  tools=$PWD/tools/oly/Spurfile
  launcher=$PWD/tools/oly/oly
  game=$PWD/$directory/consumer-game
  (cd "$directory" && sh "$launcher" new consumer-game --environment web --version "$version")
  (cd "$game" && sh "$launcher" test)

  [ "$(cat "$game/node_modules/.oly-install")" = "linux-x64 local" ] || _fail 1 "local mode left node_modules/.oly-install as: $(cat "$game/node_modules/.oly-install")"
  for file in index.html main.js consumer_game.mjs consumer_game.wasm; do
    [ -f "$game/build/web/$file" ] || _fail 1 "build/web has no $file"
  done

  # Back to the pinned version: the checkout's packages must give way to the tarballs.
  env -u OLY_ENGINE_DIR OLY_GAME_DIR="$game" sh "$SPUR_BIN" -f "$tools" sync
  [ "$(cat "$game/node_modules/.oly-install")" = "linux-x64 pinned" ] || _fail 1 "pinned sync left node_modules/.oly-install as: $(cat "$game/node_modules/.oly-install")"
  tar -xzOf "$releaseDirectory/oly-core-$version.tgz" package/dist/index.js | cmp - "$game/node_modules/@oly/core/dist/index.js" || _fail 1 "node_modules/@oly/core is not the tarball's"

  # A changed package.json makes the next sync rewrite the lock.
  touch -d '2 minutes ago' "$game/package-lock.json"
  touch "$game/package.json"
  env -u OLY_ENGINE_DIR OLY_GAME_DIR="$game" sh "$SPUR_BIN" -f "$tools" sync
  [ -z "$(find "$game/package-lock.json" -mmin +1)" ] || _fail 1 "sync did not rewrite package-lock.json after package.json changed"

  # The Docker half runs this game in local mode without the staging server.
  OLY_GAME_DIR=$game spur -f "$tools" sync
  [ "$(cat "$game/node_modules/.oly-install")" = "linux-x64 local" ] || _fail 1 "local sync left node_modules/.oly-install as: $(cat "$game/node_modules/.oly-install")"

## Run the games that consumer-test native and web left in build/consumer/ with --docker, on the host: the images are
## tagged as the ones a release publishes, under the registry oly-local.
consumer-docker: ## the Docker half of consumer-test, on the host
  version=$(sed -n 's/^project(Oly VERSION \([0-9.]*\).*/\1/p' CMakeLists.txt)
  native=$PWD/build/consumer/native/consumer-game
  web=$PWD/build/consumer/web/consumer-game
  [ -d "$native" ] && [ -d "$web" ] || _fail 64 "run ./spur consumer-test native and ./spur consumer-test web first"

  for image in wasm dev windows; do
    docker tag "cpp_services-$image" "oly-local/oly-$image:$version"
  done

  export OLY_IMAGE_REGISTRY=oly-local OLY_ENGINE_DIR=$PWD
  launcher=$PWD/tools/oly/oly
  (cd "$native" && sh "$launcher" test --docker)
  (cd "$web" && sh "$launcher" test --docker)
  (cd "$native" && sh "$launcher" test --docker --platform windows)

  # The host build of the same game, from the same folder: its cache must not collide with the Docker one.
  spur dev env OLY_ENGINE_DIR=/app OLY_TOOLS_DIR=/app/tools/oly OLY_GAME_DIR=/app/build/consumer/native/consumer-game sh ./spur -f /app/tools/oly/Spurfile test --host

  [ -d "$native/build/cmake" ] && [ -d "$native/build/cmake-docker" ] || _fail 1 "the host and Docker builds do not have their own directories"
  [ -f "$native/build/cmake-windows-docker/games/consumer_game.exe" ] || _fail 1 "the Windows build left no consumer_game.exe"

## The shell tests of tools/release, which need no engine build.
##
##   ./spur release-test
release-test: ## the tests of tools/release
  _in dev -- "$@"

  sh tools/release/tests/run.sh

## Write a version into the tree and commit it. The tag is the release pipeline's: it creates it only after every check
## passed (spec §4.2).
##
##   ./spur release 0.2.0
release: ## write <version> into the tree and commit it (on the host)
  [ "$#" -eq 1 ] || _fail 64 "usage: ./spur release <version>"
  version=$1
  [ -z "$(git status --porcelain)" ] || _fail 1 "the working tree has changes: commit or stash them first"

  sh tools/release/set_version.sh "$version" . || exit $?
  # The lock holds the workspace versions: a stale one makes the next npm ci fail. npm sits beside node in the wasm image.
  spur wasm sh -c '"$(dirname "$(command -v node)")/npm" install --package-lock-only --no-audit --no-fund' || _fail 1 "npm could not update package-lock.json; git checkout . drops the version changes"
  sh tools/release/check_version.sh "$version" . || _fail 1 "the tree does not carry $version after the update; git checkout . drops the version changes"

  if git diff --quiet; then
    printf 'already on %s\n' "$version"
  else
    git commit -am "chore(release): $version"
  fi

## Pack @oly/core and @oly/web-host into the folder given. Only the two packages are built: the games' own TypeScript
## needs generated schemas this task does not make.
##
##   ./spur stage-npm build/release/0.1.0/download/v0.1.0
stage-npm: ## npm pack the two web packages into a folder
  _in wasm -- "$@"

  [ "$#" -eq 1 ] || _fail 64 "usage: ./spur stage-npm <folder>"
  npm="$(dirname "$(command -v node)")/npm"
  [ -d node_modules ] || "$npm" ci --no-audit --no-fund
  node_modules/.bin/tsc -b engine/environments/web/clients/typescript/core engine/environments/web/host/js
  mkdir -p "$1"
  "$npm" pack -w @oly/core -w @oly/web-host --pack-destination "$1"

## Build every asset of a release into build/release/<version>, laid out as GitHub serves it, without publishing
## anything (on the host).
##
##   ./spur stage 0.1.0
stage: ## build the release assets of <version> into build/release/<version>
  [ "$#" -eq 1 ] || _fail 64 "usage: ./spur stage <version>"
  version=$1
  sh tools/release/check_version.sh "$version" . || exit $?

  directory=build/release/$version
  rm -rf "$directory"
  mkdir -p "$directory/download/v$version"

  PRESET=schema-tool-linux spur build
  PRESET=schema-tool-windows spur build
  spur stage-npm "$directory/download/v$version"
  # In the dev container: Git Bash on Windows cannot give bin/oly-schema the executable bit the archive must carry.
  spur dev sh tools/release/stage.sh "$version" "$directory"

## Run a game as a user would, with the launcher installed from the tree ./spur stage built (build/release/<version>)
## instead of from GitHub, the engine source being this checkout. No environment: web, native, then docker.
##
##   ./spur staged-test 0.1.0 web
staged-test: ## install, create, build and test a game from the staged release
  [ "$#" -ge 1 ] || _fail 64 "usage: ./spur staged-test <version> [web|native|docker]"
  version=$1
  case ${2:-} in
    web) spur staged-web "$version" ;;
    native) spur staged-native "$version" ;;
    docker) spur staged-docker "$version" ;;
    "")
      spur staged-web "$version"
      spur staged-native "$version"
      spur staged-docker "$version"
      ;;
    *) _fail 64 "usage: ./spur staged-test <version> [web|native|docker]" ;;
  esac

staged-web: ## the web half of staged-test
  _in wasm -- "$@"

  _staged_run "$1" web

staged-native: ## the native half of staged-test
  _in dev -- "$@"

  _staged_run "$1" native

## Run the games that staged-test web and native left in build/staged/ with --docker, on the host: the images are built
## from the local engine images and the staged oly-tools, and tagged as a release publishes them, under oly-local.
staged-docker: ## the Docker half of staged-test, on the host
  version=$1
  native=$PWD/build/staged/native/staged-native
  web=$PWD/build/staged/web/staged-web
  [ -d "$native" ] && [ -d "$web" ] || _fail 64 "run ./spur staged-test $version web and native first"

  sh tools/release/build_images.sh "$version" oly-local "build/release/$version"

  home=$PWD/build/staged/docker-home
  rm -rf "$home"
  mkdir -p "$home/profile"
  # The host may have no Python for _serve, and the containers need no release server: the games already hold their
  # packages. curl reads the staged folder through file://.
  root=$(cygpath -m "$PWD" 2> /dev/null || printf '%s' "$PWD")
  case $root in
    /*) url=file://$root/build/release/$version ;;
    *) url=file:///$root/build/release/$version ;;
  esac
  export OLY_RELEASE_URL=$url OLY_HOME=$home OLY_IMAGE_REGISTRY=oly-local OLY_ENGINE_SOURCE_DIR=$PWD
  curl -fsSL "$OLY_RELEASE_URL/latest/download/install.sh" -o "$home/install.sh" || _fail 1 "could not download install.sh"
  HOME=$home/profile sh "$home/install.sh" || _fail 1 "install.sh failed"

  (cd "$native" && "$home/bin/oly" test --docker)
  (cd "$web" && "$home/bin/oly" test --docker)

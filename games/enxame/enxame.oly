tag Enemy
component Turret { reload: f32 }
component Projectile { velocityX: f32, velocityY: f32, life: f32 }
component BeltItem { belt: u32, offset: f32 }
component Assembler { belt: u32, stock: u32, timer: f32 }
action pan: axis2d
action zoomIn: button
action zoomOut: button
action place: button
action cursor: pointer

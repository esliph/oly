FROM debian:trixie-slim

ARG MINGW_GCC_MINIMUM

# ccache: as in the dev image.
RUN apt-get update \
  && apt-get install -y --no-install-recommends cmake make git python3 ca-certificates ccache \
    g++-mingw-w64-x86-64-posix gcc-mingw-w64-x86-64-posix binutils-mingw-w64-x86-64 wine wine64 \
  && rm -rf /var/lib/apt/lists/*

# The MinGW comes from Debian: below the minimum there is nothing to install instead, so the build stops.
RUN found=$(x86_64-w64-mingw32-g++-posix -dumpfullversion) \
  && if ! dpkg --compare-versions "$found" ge "$MINGW_GCC_MINIMUM"; then \
    echo "MinGW GCC $found is older than MINGW_GCC_MINIMUM $MINGW_GCC_MINIMUM (toolchain.env)" >&2; exit 1; \
  fi

ENV WINEPREFIX=/opt/wine WINEDEBUG=-all

# Created once at image build: the first Wine start takes many seconds and would otherwise land inside a ctest timeout.
RUN wineboot --init

WORKDIR /app
ENV OLY_TOOLCHAIN=windows

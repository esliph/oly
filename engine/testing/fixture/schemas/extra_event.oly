# The plugins of fixture_game come first, as in its merged schema: counting, then doubling.
component Counter { value: u32 }
component Doubled { value: u32 }
component Position { x: f32, y: f32 }
component Velocity { x: f32, y: f32 }
component Mixed { a: u8, b: f64, c: i16, owner: entity }
component Trace { value: f64 }
tag Player
tag Enemy

event Counted { value: u32 }
event Ping { target: entity, value: f32 }
event Echo { depth: u32 }
event Extra { x: f32 }

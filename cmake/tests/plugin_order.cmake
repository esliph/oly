# cmake -DCASE=<case> -P plugin_order.cmake: runs oly_plugin_order on one dependency graph and prints "order=[a,b]".
# The list is printed with commas: a semicolon in a ctest PASS_REGULAR_EXPRESSION would split it into two expressions.
cmake_minimum_required(VERSION 3.25)
include(${CMAKE_CURRENT_LIST_DIR}/../OlyPlugin.cmake)

function(declare_plugin plugin)
  set_property(GLOBAL PROPERTY OLY_PLUGIN_DEPENDENCIES_${plugin} "${ARGN}")
endfunction()

if(CASE STREQUAL "independent_keep_list_order")
  declare_plugin(a)
  declare_plugin(b)
  oly_plugin_order(order a b)
elseif(CASE STREQUAL "dependency_first")
  declare_plugin(a)
  declare_plugin(b a)
  oly_plugin_order(order b)
elseif(CASE STREQUAL "dependency_listed_after")
  declare_plugin(a)
  declare_plugin(b a)
  oly_plugin_order(order b a)
elseif(CASE STREQUAL "transitive")
  declare_plugin(a)
  declare_plugin(b a)
  declare_plugin(c b)
  oly_plugin_order(order c)
elseif(CASE STREQUAL "shared_dependency_once")
  declare_plugin(a)
  declare_plugin(b a)
  declare_plugin(c a)
  oly_plugin_order(order b c)
elseif(CASE STREQUAL "cycle")
  declare_plugin(a b)
  declare_plugin(b a)
  oly_plugin_order(order a)
elseif(CASE STREQUAL "unknown")
  declare_plugin(a)
  oly_plugin_order(order a z)
else()
  message(FATAL_ERROR "unknown case ${CASE}")
endif()

list(JOIN order "," printed)
message("order=[${printed}]")

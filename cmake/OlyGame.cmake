find_program(OLY_NODE node)
set(OLY_SCHEMA_TOOL ${PROJECT_SOURCE_DIR}/build/schema-tool/bin/oly-schema CACHE FILEPATH "oly-schema executable that WASM builds of oly_add_game run")

# oly_add_game(<target> ENVIRONMENT web|native SCHEMA <file.oly> SOURCES <cpp...> DEPENDS <m...> [PLUGINS <p...>])
# Generates the schema structs and declaration with oly-schema, merging the .oly of every plugin turned on, and
# game_setup.generated.cpp, which defines oly::app::setUpGame: declare the schema, then install the plugins in dependency
# order. Compiles the game with the modules and plugins. On web it also generates the registry and links the WASM module
# (.mjs) with the web host's script invoker; on native the sources bring their own main, which calls setUpGame, and
# link the native host through DEPENDS.
function(oly_add_game target)
  _oly_add_game_target(${target} ${ARGN})
endfunction()

# oly_add_engine_test_game(...): the same arguments, for the engine's own test games only (the lint rejects it outside
# engine/): they turn on no plugin except the test plugins of engine/testing/fixture/.
function(oly_add_engine_test_game target)
  _oly_add_game_target(${target} ${ARGN})
endfunction()

function(_oly_add_game_target target)
  cmake_parse_arguments(GAME "" "ENVIRONMENT;SCHEMA" "SOURCES;DEPENDS;PLUGINS" ${ARGN})

  if(NOT GAME_ENVIRONMENT)
    message(FATAL_ERROR "${target}: oly_add_game needs ENVIRONMENT web|native")
  endif()
  if(NOT GAME_ENVIRONMENT STREQUAL OLY_ENVIRONMENT)
    message(FATAL_ERROR "${target} is a ${GAME_ENVIRONMENT} game, but this build is ${OLY_ENVIRONMENT}")
  endif()

  oly_schema_tool(schemaTool schemaToolDependency)
  oly_plugin_order(plugins ${GAME_PLUGINS})

  set(pluginArguments "")
  set(pluginSchemas "")
  set(pluginIncludes "")
  set(pluginInstalls "")
  foreach(plugin IN LISTS plugins)
    get_property(pluginSchema GLOBAL PROPERTY OLY_PLUGIN_SCHEMA_${plugin})
    if(pluginSchema)
      list(APPEND pluginArguments --plugin ${plugin}=${pluginSchema})
      list(APPEND pluginSchemas ${pluginSchema})
    endif()
    string(APPEND pluginIncludes "#include \"oly/${plugin}/plugin.hpp\"\n")
    string(APPEND pluginInstalls "    engine.installPlugin<oly::${plugin}::Plugin>();\n")
  endforeach()

  set(generatedDirectory ${CMAKE_CURRENT_BINARY_DIR}/${target}_generated)
  set(generatedHeader ${generatedDirectory}/schema.generated.hpp)
  set(generatedDeclaration ${generatedDirectory}/schema_declaration.generated.cpp)
  set(generatedRegistry ${generatedDirectory}/schema_registry.generated.cpp)
  add_custom_command(
    OUTPUT ${generatedHeader} ${generatedDeclaration} ${generatedRegistry}
    COMMAND ${schemaTool} ${GAME_SCHEMA} ${pluginArguments} --emit cpp=${generatedDirectory}
    DEPENDS ${GAME_SCHEMA} ${pluginSchemas} ${schemaToolDependency}
    COMMENT "Generating the C++ schema for ${target}"
    VERBATIM)

  set(gameSetup ${generatedDirectory}/game_setup.generated.cpp)
  file(GENERATE OUTPUT ${gameSetup} CONTENT
"// Generated by oly_add_game: do not edit.
#include \"oly/app/engine.hpp\"
#include \"oly/app/game.hpp\"
#include \"oly/app/schema.hpp\"
${pluginIncludes}
namespace oly::app {
  void setUpGame(Engine& engine) {
    declareSchema(engine);
${pluginInstalls}  }
}
")

  add_executable(${target} ${GAME_SOURCES} ${generatedDeclaration} ${generatedHeader} ${gameSetup})
  target_include_directories(${target} PRIVATE ${generatedDirectory})
  foreach(dependency IN LISTS GAME_DEPENDS plugins)
    target_link_libraries(${target} PRIVATE oly::${dependency})
  endforeach()
  oly_warnings(${target})
  set_target_properties(${target} PROPERTIES RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/games)

  if(GAME_ENVIRONMENT STREQUAL "web")
    target_sources(${target} PRIVATE ${generatedRegistry})
    set_target_properties(${target} PROPERTIES SUFFIX ".mjs")
    target_link_libraries(${target} PRIVATE oly::web_host)
    # EXIT_RUNTIME=0 overrides the global =1: TS calls the module after it loads, so the runtime must not exit.
    target_link_options(${target} PRIVATE
      -sMODULARIZE=1 -sEXPORT_ES6=1 -sENVIRONMENT=node,web
      -sEXPORTED_FUNCTIONS=_malloc,_free -sEXPORTED_RUNTIME_METHODS=HEAPU8 -sEXIT_RUNTIME=0)
  endif()

  oly_register_target(OLY_GAMES ${target} ${CMAKE_CURRENT_SOURCE_DIR} ${GAME_DEPENDS} ${plugins})
endfunction()

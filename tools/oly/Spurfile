# The game-side toolchain, run as: spur -f <oly-tools>/Spurfile <task>, with the game as the working directory.
# OLY_TOOLS_DIR is an extracted oly-tools archive or, in local mode, $OLY_ENGINE_DIR/tools/oly. OLY_GAME_DIR is the game
# root: spur enters the Spurfile's directory, so the launcher passes the game here.

_fail() {
  printf 'oly %s: %s\n' "$SPUR_TASK" "$2" >&2
  exit "$1"
}

_platform() {
  case $(uname -s) in
    Linux) echo linux-x64 ;;
    MINGW* | MSYS*) echo windows-x64 ;;
    *) _fail 64 "unsupported host $(uname -s): oly runs on Linux and on Windows in Git Bash" ;;
  esac
}

_exe() {
  case $(_platform) in
    windows-x64) echo .exe ;;
  esac
}

# Git Bash paths (/c/...) mean nothing to node, JSON or docker -v.
_host_path() {
  if command -v cygpath > /dev/null 2>&1; then
    cygpath -m "$1"
  else
    printf '%s\n' "$1"
  fi
}

# _asset <path in the oly-tools archive> <path in the engine checkout>
_asset() {
  if [ -n "${OLY_ENGINE_DIR:-}" ]; then
    printf '%s/%s\n' "$OLY_ENGINE_DIR" "$2"
  elif [ -n "${OLY_TOOLS_DIR:-}" ]; then
    printf '%s/%s\n' "$OLY_TOOLS_DIR" "$1"
  else
    _fail 64 "OLY_TOOLS_DIR is not set"
  fi
}

# _env_value <key>: reads oly.env of the current directory.
_env_value() {
  [ -f oly.env ] || _fail 64 "oly.env not found: run inside a game"
  _line=$(sed -n "s/^$1=//p" oly.env | tr -d '\r' | tail -n 1)
  [ -n "$_line" ] || _fail 64 "oly.env has no $1"
  printf '%s\n' "$_line"
}

# _version_at_least <found> <minimum>: numeric per dot field; a tail such as -ubuntu1 is ignored.
_version_at_least() {
  awk -v found="$1" -v minimum="$2" 'BEGIN {
    foundCount = split(found, foundFields, ".")
    minimumCount = split(minimum, minimumFields, ".")
    count = foundCount > minimumCount ? foundCount : minimumCount
    for (field = 1; field <= count; field++) {
      if (foundFields[field] + 0 > minimumFields[field] + 0) exit 0
      if (foundFields[field] + 0 < minimumFields[field] + 0) exit 1
    }
    exit 0
  }'
}

# The emsdk image keeps npm beside node, off the PATH.
_npm() {
  if command -v npm > /dev/null 2>&1; then
    npm "$@"
  else
    "$(dirname "$(command -v node)")/npm" "$@"
  fi
}

# Escapes a value for the replacement side of sed s|...|...|.
_sed_replacement() {
  printf '%s' "$1" | sed 's/[\\&|]/\\&/g'
}

# The engine C++ source: the checkout in local mode, the staged source of a release run, else empty so FetchContent
# fetches the pinned tag. Passed on every configure, empty included: a value left in the CMake cache by an earlier
# local run would otherwise keep building the checkout.
_engine_source() {
  _source=${OLY_ENGINE_DIR:-${OLY_ENGINE_SOURCE_DIR:-}}
  if [ -n "$_source" ]; then
    _host_path "$_source"
  fi
}

# CMake's default generator on Windows is Visual Studio, which drives neither MinGW nor Emscripten.
_generator_arguments() {
  if [ "$(_platform)" = windows-x64 ]; then
    echo "-G Ninja"
  fi
}

_build_native() {
  _source=$(_engine_source)
  cmake -S . -B build/cmake $(_generator_arguments) -DCMAKE_BUILD_TYPE=Debug -DOLY_BUILD_NATIVE_HOST=ON "-DFETCHCONTENT_SOURCE_DIR_OLY=$_source"
  cmake --build build/cmake -j
}

# local when OLY_ENGINE_DIR names a checkout, else pinned.
_mode() {
  if [ -n "${OLY_ENGINE_DIR:-}" ]; then
    echo local
  else
    echo pinned
  fi
}

# _toolchain_value <key>: a value of toolchain.env.
_toolchain_value() {
  sed -n "s/^$1=//p" "$(_asset toolchain.env toolchain.env)" | tr -d '\r'
}

# oly.env and package.json both carry the version, and must not diverge.
_check_pins() {
  _pinned=$(_env_value OLY_VERSION)
  for _tarball in oly-core oly-web-host; do
    grep -qF "$_tarball-$_pinned.tgz" package.json || _fail 64 "oly.env pins $_pinned but package.json has other @oly tarballs: run oly upgrade $_pinned"
  done
}

# _overlay_package <package> <directory of its checkout> <lib>: compiles the checkout's package over the installed
# tarball, writing nothing into the checkout and leaving package.json alone. The installed copy is emptied first, so
# nothing of the tarball stays.
_overlay_package() {
  _checkout=$(_host_path "$OLY_ENGINE_DIR")
  _game=$(_host_path "$PWD")
  _installed=node_modules/@oly/$1
  _config=build/oly-local/tsconfig.$1.json
  _paths=
  # The checkout's source resolves @oly/core by walking up from the checkout, which has no node_modules here.
  if [ "$1" = web-host ]; then
    _paths=", \"paths\": { \"@oly/core\": [\"$_game/node_modules/@oly/core/dist/index.d.ts\"] }"
  fi

  mkdir -p build/oly-local
  cat > "$_config" << JSON
{
  "extends": "$_checkout/tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "rootDir": "$_checkout/$2/src",
    "outDir": "$_game/$_installed/dist",
    "lib": $3,
    "types": []$_paths
  },
  "include": ["$_checkout/$2/src"]
}
JSON

  rm -rf "$_installed"
  mkdir -p "$_installed"
  cp "$OLY_ENGINE_DIR/$2/package.json" "$_installed/package.json"
  node_modules/.bin/tsc -p "$(_host_path "$_config")"
}

# Brings node_modules to what package.json and the mode say, and records it in node_modules/.oly-install. A platform
# or mode change reinstalls: esbuild ships a binary per platform, and the checkout's packages must not outlive local mode.
_sync() {
  _want="$(_platform) $(_mode)"
  _marker=node_modules/.oly-install
  if [ -f "$_marker" ] && [ "$(cat "$_marker")" != "$_want" ]; then
    rm -rf node_modules
  fi

  if [ ! -f package-lock.json ] || [ package.json -nt package-lock.json ]; then
    _npm install --no-audit --no-fund
    # npm leaves a lock it did not change alone, which would stay older than package.json and repeat this install.
    touch package-lock.json
  elif [ ! -f "$_marker" ] || [ package-lock.json -nt "$_marker" ]; then
    _npm ci --no-audit --no-fund
  fi

  if [ "$(_mode)" = local ]; then
    _overlay_package core engine/environments/web/clients/typescript/core '["ES2022"]'
    _overlay_package web-host engine/environments/web/host/js '["ES2022", "DOM"]'
  fi

  printf '%s\n' "$_want" > "$_marker"
}

# Local mode builds oly-schema from the checkout; a pinned version brings it prebuilt.
_build_schema_tool() {
  if [ -z "${OLY_ENGINE_DIR:-}" ]; then
    return 0
  fi

  cmake -S "$(_host_path "$OLY_ENGINE_DIR")" -B build/oly-schema $(_generator_arguments) -DCMAKE_BUILD_TYPE=Release -DOLY_BUILD_TESTS=OFF -DOLY_WERROR=OFF
  cmake --build build/oly-schema --target oly-schema -j
}

_schema_tool_path() {
  if [ -n "${OLY_ENGINE_DIR:-}" ]; then
    echo "$(_host_path "$PWD")/build/oly-schema/bin/oly-schema$(_exe)"
  else
    echo "$(_host_path "${OLY_TOOLS_DIR:?}")/bin/oly-schema$(_exe)"
  fi
}

_esbuild() {
  node_modules/.bin/esbuild web/dist/src/main.js --bundle --format=esm --platform=browser --target=es2022 "$@"
}

_build_web() {
  _check_pins
  _sync
  if [ -z "${EMSDK:-}" ]; then
    _fail 64 "EMSDK is not set: install emsdk $(_toolchain_value EMSDK_VERSION) and source emsdk_env.sh"
  fi

  _build_schema_tool
  _source=$(_engine_source)
  _tool=$(_schema_tool_path)
  _game_target=$(_env_value OLY_GAME)
  cmake -S . -B build/cmake $(_generator_arguments) \
    "-DCMAKE_TOOLCHAIN_FILE=$(_host_path "$EMSDK")/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake" \
    -DCMAKE_BUILD_TYPE=Debug "-DOLY_SCHEMA_TOOL=$_tool" "-DFETCHCONTENT_SOURCE_DIR_OLY=$_source"
  # The TS code imports the generated schema, so it exists before tsc.
  cmake --build build/cmake --target oly_typescript_schemas
  cmake --build build/cmake -j
  node_modules/.bin/tsc -b

  mkdir -p build/web
  _esbuild --outfile=build/web/main.js
  cp web/index.html "build/cmake/games/$_game_target.mjs" "build/cmake/games/$_game_target.wasm" build/web/
}

# _doctor_report <ok|old|untested|missing|wrong> <message>
_doctor_report() {
  printf '%-8s %s\n' "$1" "$2"
  if [ "$1" != ok ]; then
    _doctor_failed=1
  fi
}

# _doctor_minimum <tool> <found> <minimum> <what to install>
_doctor_minimum() {
  if _version_at_least "$2" "$3"; then
    _doctor_report ok "$1 $2 (needs $3 or newer)"
  else
    _doctor_report old "$1 $2 (needs $3 or newer): $4"
  fi
}

# _doctor_present <command> <what to install>
_doctor_present() {
  if command -v "$1" > /dev/null 2>&1; then
    _doctor_report ok "$1"
  else
    _doctor_report missing "$1: $2"
  fi
}

_doctor_cmake() {
  if ! command -v cmake > /dev/null 2>&1; then
    _doctor_report missing "cmake: install CMake $(_toolchain_value CMAKE_MINIMUM) or newer"
    return 0
  fi

  _doctor_minimum cmake "$(cmake --version | sed -n '1s/.* //p')" "$(_toolchain_value CMAKE_MINIMUM)" "install CMake $(_toolchain_value CMAKE_MINIMUM) or newer"
}

_doctor_ninja() {
  _needed=$(_toolchain_value NINJA_MINIMUM)
  if ! command -v ninja > /dev/null 2>&1; then
    _doctor_report missing "ninja: install Ninja $_needed or newer (MSYS2: pacman -S mingw-w64-ucrt-x86_64-ninja)"
    return 0
  fi

  _doctor_minimum ninja "$(ninja --version)" "$_needed" "install Ninja $_needed or newer"
}

_doctor_web() {
  _needed=$(_toolchain_value EMSDK_VERSION)
  if ! command -v emcc > /dev/null 2>&1; then
    _doctor_report missing "emcc: install emsdk $_needed and source emsdk_env.sh"
  else
    _found=$(emcc --version | sed -n '1s/.* \([0-9][0-9.]*\) (.*/\1/p')
    if [ "$_found" = "$_needed" ]; then
      _doctor_report ok "emcc $_found"
    elif _version_at_least "$_found" "$_needed"; then
      _doctor_report untested "emcc $_found (tested with $_needed): install emsdk $_needed"
    else
      _doctor_report old "emcc $_found (needs $_needed): install emsdk $_needed"
    fi
  fi

  _doctor_present node "install Node.js"
  if command -v npm > /dev/null 2>&1 || { command -v node > /dev/null 2>&1 && [ -x "$(dirname "$(command -v node)")/npm" ]; }; then
    _doctor_report ok npm
  else
    _doctor_report missing "npm: install Node.js with npm"
  fi
}

_doctor_native() {
  if ! command -v g++ > /dev/null 2>&1; then
    _doctor_report missing "g++: install GCC $(_toolchain_value GCC_MINIMUM) or newer"
    return 0
  fi

  if [ "$(_platform)" = windows-x64 ]; then
    _machine=$(g++ -dumpmachine)
    case $_machine in
      *mingw32*) _doctor_minimum "g++ (MinGW)" "$(g++ -dumpversion)" "$(_toolchain_value MINGW_GCC_MINIMUM)" "install MinGW GCC $(_toolchain_value MINGW_GCC_MINIMUM) or newer (MSYS2 UCRT64)" ;;
      *) _doctor_report wrong "g++ targets $_machine, not MinGW: use the MSYS2 UCRT64 shell" ;;
    esac
  else
    _doctor_minimum g++ "$(g++ -dumpversion)" "$(_toolchain_value GCC_MINIMUM)" "install GCC $(_toolchain_value GCC_MINIMUM) or newer"
  fi
}

# _doctor <environments> <docker|host>: prints one line per check; returns 1 when any is not ok.
_doctor() {
  _doctor_failed=0

  if [ "$2" = docker ]; then
    if docker compose version > /dev/null 2>&1; then
      _doctor_report ok "docker compose $(docker compose version --short 2> /dev/null)"
    else
      _doctor_report missing "docker compose: install Docker with the compose plugin"
    fi
    return "$_doctor_failed"
  fi

  _doctor_cmake
  if [ "$(_platform)" = windows-x64 ]; then
    _doctor_ninja
  fi
  for _environment in $1; do
    case $_environment in
      web) _doctor_web ;;
      native) _doctor_native ;;
    esac
  done

  return "$_doctor_failed"
}

# A task never calls spur again: it would look for a Spurfile from the game directory and find the game's parents'.
_build() {
  _environment=$(_env_value OLY_ENVIRONMENT)
  _doctor "$_environment" host || _fail 1 "the host tools do not match toolchain.env (see above)"
  case $_environment in
    native) _build_native ;;
    web) _build_web ;;
    *) _fail 64 "oly.env: OLY_ENVIRONMENT is web or native" ;;
  esac
}

cd "${OLY_GAME_DIR:-$SPUR_INVOCATION_DIR}"

## Create a game from the template.
##
##   oly new meu-jogo --environment web
new: ## create <name>/ from the template: new <name> --environment web|native
  name=
  environment=
  while [ "$#" -gt 0 ]; do
    case $1 in
      --environment)
        [ "$#" -ge 2 ] || _fail 64 "--environment is web or native"
        environment=$2
        shift 2
        ;;
      -*) _fail 64 "unknown option: $1" ;;
      *)
        [ -z "$name" ] || _fail 64 "usage: oly new <name> --environment web|native"
        name=$1
        shift
        ;;
    esac
  done

  [ -n "$name" ] || _fail 64 "usage: oly new <name> --environment web|native"
  printf '%s' "$name" | LC_ALL=C grep -Eq '^[a-z][a-z0-9-]*$' || _fail 64 "game name must match [a-z][a-z0-9-]*: $name"
  case $environment in
    web | native) ;;
    *) _fail 64 "--environment is web or native" ;;
  esac
  [ -n "${OLY_VERSION:-}" ] || _fail 64 "OLY_VERSION is not set"
  [ ! -e "$name" ] || _fail 64 "$name already exists"

  template=$(_asset template templates/game)
  [ -d "$template/$environment" ] || _fail 64 "the template has no $environment overlay: $template"

  target=$(printf '%s' "$name" | tr - _)
  releaseUrl=${OLY_RELEASE_URL:-https://github.com/esliph/oly/releases}

  mkdir "$name"
  cp -R "$template/common/." "$name/"
  cp -R "$template/$environment/." "$name/"
  mv "$name/gitignore" "$name/.gitignore"
  mv "$name/game.oly" "$name/$name.oly"

  find "$name" -type f | while IFS= read -r file; do
    sed -e "s|@GAME_NAME@|$(_sed_replacement "$name")|g" \
      -e "s|@GAME_TARGET@|$(_sed_replacement "$target")|g" \
      -e "s|@OLY_VERSION@|$(_sed_replacement "$OLY_VERSION")|g" \
      -e "s|@OLY_ENVIRONMENT@|$environment|g" \
      -e "s|@OLY_RELEASE_URL@|$(_sed_replacement "$releaseUrl")|g" \
      "$file" > "$file.oly-new"
    mv "$file.oly-new" "$file"
  done

  if [ "$environment" = web ]; then
    (cd "$name" && _npm install --no-audit --no-fund && printf '%s pinned\n' "$(_platform)" > node_modules/.oly-install)
  fi

  printf 'created %s (%s, oly %s)\n' "$name" "$environment" "$OLY_VERSION"

platform: ## print the host platform: linux-x64 or windows-x64
  _platform

build: ## build the game
  _build

test: ## build the game and run its tests
  _build
  ctest --test-dir build/cmake --output-on-failure --no-tests=error

## Build the game and run it; the arguments go to the game.
##
##   oly run --frames 60
run: ## build the game and run it
  _build
  case $(_env_value OLY_ENVIRONMENT) in
    native) exec "build/cmake/games/$(_env_value OLY_GAME)$(_exe)" "$@" ;;
    web) _esbuild --outfile=build/web/main.js --servedir=build/web --serve=0.0.0.0:8000 ;;
  esac

clean: ## remove build/
  rm -rf build

sync: ## install the npm packages of a web game
  _sync

## Check the host tools against toolchain.env. Inside a game it checks the game's environment, outside both. With
## --docker, or OLY_RUNNER=docker in oly.env, it checks only docker compose. Exits 1 when any line is not ok.
##
##   oly doctor --environment web
doctor: ## check the host tools against toolchain.env
  environments="web native"
  runner=host
  if [ -f oly.env ]; then
    environments=$(_env_value OLY_ENVIRONMENT)
    runner=$(sed -n 's/^OLY_RUNNER=//p' oly.env | tr -d '\r' | tail -n 1)
  fi

  while [ "$#" -gt 0 ]; do
    case $1 in
      --environment)
        [ "$#" -ge 2 ] || _fail 64 "--environment is web or native"
        environments=$2
        shift 2
        ;;
      --docker)
        runner=docker
        shift
        ;;
      --host)
        runner=host
        shift
        ;;
      *) _fail 64 "unknown option: $1" ;;
    esac
  done

  case $environments in
    web | native | "web native") ;;
    *) _fail 64 "--environment is web or native" ;;
  esac

  _doctor "$environments" "$runner"

version-at-least: ## exit 0 when <found> is at least <minimum>
  _version_at_least "$1" "$2"

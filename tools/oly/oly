#!/bin/sh
# Finds the game, fetches the oly-tools of the version it pins and runs that version's Spurfile task. It rarely changes:
# game logic belongs in the version's Spurfile.

OLY_LAUNCHER_VERSION=dev
launcher_end="# end of oly"

oly_home=${OLY_HOME:-$HOME/.oly}
release_url=${OLY_RELEASE_URL:-https://github.com/esliph/oly/releases}

fail() {
  printf 'oly: %s\n' "$2" >&2
  exit "$1"
}

# Mirrors _platform of the Spurfile, which is not there yet when a version is being fetched.
platform() {
  case $(uname -s) in
    Linux) echo linux-x64 ;;
    MINGW* | MSYS*) echo windows-x64 ;;
    *) fail 64 "unsupported host $(uname -s): oly runs on Linux and on Windows in Git Bash" ;;
  esac
}

# The nearest folder from $PWD up that holds oly.env; prints nothing outside a game.
find_game_root() {
  directory=$PWD
  while [ ! -f "$directory/oly.env" ]; do
    parent=$(dirname "$directory")
    if [ "$parent" = "$directory" ]; then
      return 0
    fi
    directory=$parent
  done
  printf '%s\n' "$directory"
}

valid_version() {
  printf '%s' "$1" | LC_ALL=C grep -Eq '^[0-9A-Za-z][0-9A-Za-z.-]*$'
}

# The version names a folder and a URL, so it is checked before either is built.
pinned_version() {
  version=$(sed -n 's/^OLY_VERSION=//p' "$1/oly.env" | tr -d '\r' | tail -n 1)
  [ -n "$version" ] || fail 64 "$1/oly.env has no OLY_VERSION"
  valid_version "$version" || fail 64 "OLY_VERSION in $1/oly.env is not a valid version: $version"
  printf '%s\n' "$version"
}

latest_version() {
  url=$release_url/latest/download/VERSION
  version=$(curl -fsSL "$url") || fail 1 "could not read the latest version from $url"
  printf '%s\n' "$version" | tr -d '[:space:]'
}

# The version a command outside a game runs with: the checkout's own in local mode, else the latest release.
default_version() {
  if [ -n "${OLY_ENGINE_DIR:-}" ]; then
    version=$(sed -n 's/^project(Oly VERSION \([0-9.]*\).*/\1/p' "$OLY_ENGINE_DIR/CMakeLists.txt" 2> /dev/null)
    [ -n "$version" ] || fail 1 "could not read the version from project(Oly VERSION) in $OLY_ENGINE_DIR/CMakeLists.txt"
    printf '%s\n' "$version"
  else
    latest_version
  fi
}

# The archive is extracted beside its final folder and moved in whole, so an interrupted run never leaves a half-filled
# versions/<version> for the next run to trust.
install_tools() {
  version=$1
  host_platform=$(platform) || exit $?
  file=oly-tools-$version-$host_platform.tar.gz
  url=$release_url/download/v$version/$file
  staging=$oly_home/versions/.download-$version-$$

  mkdir -p "$staging/tools" || fail 1 "could not create $staging"
  trap 'rm -rf "$staging"; exit 1' INT TERM HUP
  # tar reads the archive by a relative path: an absolute one such as C:/... would be taken for a remote host.
  if curl -fsSL "$url" -o "$staging/$file" \
    && (cd "$staging/tools" && tar -xzf "../$file") \
    && [ -f "$staging/tools/spur" ] && [ -f "$staging/tools/Spurfile" ]; then
    # A folder without spur is what an older failed install left: nothing trusts it. A complete one from a parallel run
    # stays, since mv would move the new folder inside it.
    if [ ! -f "$oly_home/versions/$version/spur" ]; then
      rm -rf "${oly_home:?}/versions/$version"
      mv "$staging/tools" "$oly_home/versions/$version" || { rm -rf "$staging"; fail 1 "could not move oly-tools $version into $oly_home/versions"; }
    fi
    rm -rf "$staging"
  else
    rm -rf "$staging"
    fail 1 "could not install oly-tools $version from $url"
  fi
  trap - INT TERM HUP
}

# run_version <version> <game root> <spur arguments...>
run_version() {
  version=$1
  root=$2
  shift 2

  if [ -n "${OLY_ENGINE_DIR:-}" ]; then
    tools=$OLY_ENGINE_DIR/tools/oly
    runner=$OLY_ENGINE_DIR/spur
  else
    tools=$oly_home/versions/$version
    runner=$tools/spur
    if [ ! -f "$runner" ]; then
      install_tools "$version"
    fi
  fi

  OLY_GAME_DIR=$root
  OLY_TOOLS_DIR=$tools
  OLY_VERSION=$version
  export OLY_GAME_DIR OLY_TOOLS_DIR OLY_VERSION
  exec sh "$runner" -f "$tools/Spurfile" -C "$root" "$@"
}

print_version() {
  printf 'oly %s\n' "$OLY_LAUNCHER_VERSION"
  root=$(find_game_root)
  if [ -z "$root" ]; then
    return 0
  fi

  if [ -n "${OLY_ENGINE_DIR:-}" ]; then
    printf 'engine %s (local)\n' "$OLY_ENGINE_DIR"
  else
    engine_version=$(pinned_version "$root") || exit $?
    printf 'engine %s (oly.env)\n' "$engine_version"
  fi
}

# oly new <name> ...: strips --version <version>; the version's `new` task makes the game in the current folder.
new_command() {
  version=
  count=$#
  while [ "$count" -gt 0 ]; do
    argument=$1
    shift
    count=$((count - 1))
    if [ "$argument" = --version ]; then
      [ "$count" -gt 0 ] || fail 64 "--version needs a value"
      version=$1
      shift
      count=$((count - 1))
    else
      set -- "$@" "$argument"
    fi
  done

  if [ -z "$version" ]; then
    version=$(default_version) || exit $?
  fi
  valid_version "$version" || fail 64 "$version is not a valid version"
  run_version "$version" "$PWD" new "$@"
}

# Rewrites the file through a temporary one, so a failed sed never truncates it.
rewrite() {
  file=$1
  shift
  if ! sed "$@" "$file" > "$file.oly-new" || ! mv "$file.oly-new" "$file"; then
    rm -f "$file.oly-new"
    fail 1 "could not rewrite $file"
  fi
}

# True when package.json already names both tarballs of the version.
package_on_version() {
  grep -qF "oly-core-$1.tgz" "$2/package.json" && grep -qF "oly-web-host-$1.tgz" "$2/package.json"
}

# The copy is checked before it replaces ./oly: it parses and ends with the closing line, which a cut copy lacks. mv swaps
# the file whole, so the old one is never half written and the running shell keeps reading it.
replace_launcher() {
  version=$1
  root=$2
  launcher_file=$oly_home/versions/$version/oly
  temporary=$root/oly.oly-new

  [ -f "$launcher_file" ] || fail 1 "oly-tools $version has no launcher to copy into $root"

  if cp "$launcher_file" "$temporary" && sh -n "$temporary" && [ "$(tail -n 1 "$temporary")" = "$launcher_end" ] \
    && chmod +x "$temporary" && mv "$temporary" "$root/oly"; then
    return 0
  fi

  rm -f "$temporary"
  fail 1 "could not replace $root/oly with the launcher of $version"
}

upgrade_command() {
  target=${1:-}
  [ -n "$target" ] || fail 64 "usage: oly upgrade <version>"
  valid_version "$target" || fail 64 "$target is not a valid version"

  root=$(find_game_root)
  [ -n "$root" ] || fail 64 "not inside an Oly game: no oly.env in $PWD or above"
  current=$(pinned_version "$root") || exit $?
  # Fetched before anything is rewritten, local mode included: a version that does not exist leaves the game as it was.
  # It also comes before the test below, which reads the version's launcher from the cache.
  if [ ! -f "$oly_home/versions/$target/spur" ]; then
    install_tools "$target"
  fi

  # oly.env alone does not say the game is on the version: a hand edit or a failed earlier sync leaves package.json behind,
  # and a lost or edited ./oly differs from the version's launcher.
  if [ "$current" = "$target" ] && cmp -s "$oly_home/versions/$target/oly" "$root/oly" \
    && { [ ! -f "$root/package.json" ] || package_on_version "$target" "$root"; }; then
    printf 'already on %s\n' "$target"
    exit 0
  fi

  replace_launcher "$target" "$root"
  rewrite "$root/oly.env" "s/^OLY_VERSION=.*/OLY_VERSION=$target/"
  if [ ! -f "$root/package.json" ]; then
    printf 'oly.env now pins %s\n' "$target"
    exit 0
  fi

  rewrite "$root/package.json" \
    -e "s|/v[^/]*/oly-core-[^/]*\.tgz|/v$target/oly-core-$target.tgz|g" \
    -e "s|/v[^/]*/oly-web-host-[^/]*\.tgz|/v$target/oly-web-host-$target.tgz|g"
  run_version "$target" "$root" sync
}


# With -C the Spurfile reads a relative checkout from the game root, not from where oly was run.
if [ -n "${OLY_ENGINE_DIR:-}" ]; then
  OLY_ENGINE_DIR=$(cd "$OLY_ENGINE_DIR" 2> /dev/null && pwd) || fail 64 "OLY_ENGINE_DIR is not a directory: $OLY_ENGINE_DIR"
  export OLY_ENGINE_DIR
fi

case ${1:-} in
  --version)
    print_version
    exit 0
    ;;
  new)
    shift
    new_command "$@"
    ;;
  upgrade)
    shift
    upgrade_command "$@"
    ;;
esac

game_root=$(find_game_root)
if [ -n "$game_root" ]; then
  game_version=$(pinned_version "$game_root") || exit $?
elif [ "${1:-}" = doctor ]; then
  game_root=$PWD
  game_version=$(default_version) || exit $?
else
  fail 64 "not inside an Oly game: no oly.env in $PWD or above"
fi

run_version "$game_version" "$game_root" "$@"
# end of oly

{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "composite": true,
    "declaration": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false,
    "rootDir": ".",
    "outDir": "dist",
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["schema.generated.ts", "src"],
  "exclude": ["src/main.ts"]
}

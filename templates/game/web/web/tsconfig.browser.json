{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "composite": true,
    "declaration": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false,
    "rootDir": ".",
    "outDir": "dist",
    "lib": ["ES2022", "DOM"],
    "types": []
  },
  "include": ["src/main.ts", "src/game.ts"],
  "references": [{ "path": "./tsconfig.json" }]
}

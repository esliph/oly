# The toolchain the images are built with and the configure check enforces. Read by cmake/OlyToolchain.cmake and, through
# ./spur images, by the Dockerfiles; a version lives only here.
#
# The versions are exact for Emscripten (the one the engine is tested with) and for the images. The *_MINIMUM values are
# not bisected: they equal the versions the images test with, so an older toolchain is untested, not known to fail.
EMSDK_VERSION=3.1.74
GCC_VERSION=14
GCC_MINIMUM=14
MINGW_GCC_MINIMUM=14
CMAKE_VERSION=3.30.5
CMAKE_MINIMUM=3.25
NINJA_MINIMUM=1.11
